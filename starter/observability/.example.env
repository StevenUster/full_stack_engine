# Required. The app sends it as OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20<token>.
# Generate with: openssl rand -hex 32
OTLP_TOKEN=

# Required. The Grafana login (user `admin` unless GRAFANA_ADMIN_USER is set).
GRAFANA_ADMIN_PASSWORD=

# The URL Grafana is reached at — used in alert links.
# GRAFANA_ROOT_URL=https://grafana.example.com

# Bind addresses and ports. 127.0.0.1 keeps a port off the network, for when a
# reverse proxy on the same host terminates TLS in front of it (recommended).
# OTLP_BIND=127.0.0.1
# OTLP_PORT=4318
# GRAFANA_BIND=127.0.0.1
# GRAFANA_PORT=3000

# How long data is kept.
# TRACE_RETENTION=336h     # 14 days
# METRICS_RETENTION=30d
