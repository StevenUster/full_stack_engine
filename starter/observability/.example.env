# Required. The app sends it as OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20<token>.
# Generate with: openssl rand -hex 32
OTLP_TOKEN=

# Required. The Grafana login (user `admin` unless GRAFANA_ADMIN_USER is set).
# Used on the first start only — see README.md to change it later.
GRAFANA_ADMIN_PASSWORD=

# Required. Grafana's public URL, e.g. https://grafana.example.com
# (http://localhost:3000 when running with docker-compose.local.yml).
GRAFANA_ROOT_URL=

# Optional — retention.
# TRACE_RETENTION=336h          # 14 days
# METRICS_RETENTION=30d
# METRICS_RETENTION_SIZE=5GB

# Optional — memory limits per container.
# COLLECTOR_MEMORY=512m
# TEMPO_MEMORY=2g
# PROMETHEUS_MEMORY=1g
# GRAFANA_MEMORY=512m
