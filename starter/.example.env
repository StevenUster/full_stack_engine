ENV=dev # or prod

DATABASE_URL=sqlite:./data/sqlite.db

DOMAIN=0.0.0.0 # for prod use something like example.com without https
PROTOCOL=http # http or https
PORT=8080

JWT_SECRET=base64_encoded_secret # min 32 chars; generate with `openssl rand -base64 32` (the app refuses to boot with a shorter secret)

# SMTP is needed for password reset and email verification
SMTP_HOST=smtp.example.de:587 # Port 587 is recommended for production
SMTP_PASS=your_smtp_password
SMTP_USER=info@example.de 
EMAIL_VERIFICATION_ENABLED=false # optional

# Optional: site-wide per-IP rate limit applied to every request (DDoS guard).
# Defaults are generous; only set these to tune. Raise for large shared/NAT IPs.
# GLOBAL_RATE_LIMIT_PER_SECOND=100
# GLOBAL_RATE_LIMIT_BURST=500

# Every variable above is read and validated ONCE at boot: the app reports all
# configuration problems together and refuses to start, rather than failing on
# the first one or — as with SMTP before — starting fine and failing weeks later
# at the first password reset. Notably:
#   * SMTP_HOST/SMTP_USER/SMTP_PASS must be set together or not at all.
#   * EMAIL_VERIFICATION_ENABLED=true without SMTP is a boot error, because new
#     accounts could never be verified.
#   * PROTOCOL must be http or https; PORT must be a usable port number.
#
# Health probes (no configuration needed):
#   GET /healthz  — liveness, touches nothing
#   GET /readyz   — readiness, pings the database pool
#   ./starter --healthcheck  — probes /healthz and exits 0/1, for Docker

# ── Observability ───────────────────────────────────────────────────────────
# Sensible defaults mean none of this is required locally: dev logs at `debug`
# in colourised multi-line form, prod logs at `info` as one JSON object per
# line, and nothing is exported anywhere until an endpoint is configured.

# LOG_LEVEL=info          # app's own level; dev defaults to debug, prod to info
# LOG_FORMAT=json         # pretty (dev default) | compact | json (prod default)
# RUST_LOG=info,sqlx=debug  # full directive syntax; overrides LOG_LEVEL, and
#                           # can re-enable a dependency the framework quiets.
#                           # `full_stack_engine::access=off` drops the
#                           # one-line-per-request access log.

# Identity attached to every log line, span and error report. SERVICE_NAME and
# SERVICE_VERSION default to the values baked in by src/lib.rs (crate name and
# version); override SERVICE_VERSION in CI with the commit SHA, since two
# builds of the same version are not the same binary.
# SERVICE_NAME=starter
# SERVICE_VERSION=1.4.2
# DEPLOY_ENV=staging      # deployment.environment.name; defaults from ENV

# Distributed tracing. Any OTLP-compatible backend: an OpenTelemetry
# Collector, Grafana Tempo, Jaeger, Honeycomb, Datadog's OTLP intake, ... The
# endpoint is a base URL; `/v1/traces` is appended. Setting it turns export on.
# Locally:  docker run -p 4318:4318 otel/opentelemetry-collector
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20your-token  # hosted backends
# TELEMETRY_SAMPLE_RATIO=0.1   # 1.0 (default) records every trace; lower it on
#                              # a busy service. An incoming sampled
#                              # traceparent is always honoured regardless.
# TELEMETRY_ENABLED=false      # hard off-switch without unsetting the endpoint

# Error and panic reporting to any Sentry-protocol backend (Sentry, GlitchTip,
# self-hosted). Requires the framework's "sentry" feature in Cargo.toml.
# Personal data is not sent (send_default_pii stays off).
# SENTRY_DSN=https://key@glitchtip.example.com/1
