---
/**
 * The app shell's navigation. Everything is data-driven: the framework
 * injects `nav` (the admin page of every model the user may read) and
 * `user`; app-specific links come from the SidebarLinks extension point.
 */
import { Image } from "astro:assets";
import { ssr } from "fse-ssr/ssr";
import logo from "../assets/logo.svg";
import NavLink from "./NavLink.astro";
import SidebarLinks from "./SidebarLinks.astro";
import type { ShellContext } from "../types";

const { t, nav, user, lang_prefix } = ssr<ShellContext>();
---

<div
  id="sidebar-backdrop"
  class="fixed inset-0 z-30 bg-secondary-900/40 backdrop-blur-xs lg:hidden hidden opacity-0 transition-opacity duration-300"
>
</div>

<aside
  id="nav-menu-1"
  aria-label="Side navigation"
  class="fixed lg:sticky top-0 bottom-0 h-dvh left-0 z-40 flex flex-col bg-white border-r border-secondary-200 w-64 transform -translate-x-full lg:translate-x-0 transition-all duration-300 ease-in-out overflow-hidden"
  transition:name="sidebar"
  transition:persist
  transition:animate="none"
>
  <div id="sidebar-header" class="relative flex items-center justify-center h-16 shrink-0 px-2">
    <a
      aria-label="Home"
      class="sidebar-full-logo flex items-center gap-2 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary-500 rounded-md"
      href={`${lang_prefix}/`}
    >
      <Image src={logo} alt="Logo" class="h-9 w-auto" />
    </a>

    <button
      id="toggle-sidebar-mini"
      class="hidden lg:flex absolute right-2 p-2 text-secondary-500 hover:text-secondary-800 hover:bg-secondary-100 rounded-lg transition-colors focus:outline-hidden"
      aria-label="Toggle sidebar"
    >
      <svg class="sidebar-icon-collapse" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><path d="M9 3v18"></path><path d="m16 15-3-3 3-3"></path>
      </svg>
      <svg class="sidebar-icon-expand hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><path d="M9 3v18"></path><path d="m14 9 3 3-3 3"></path>
      </svg>
    </button>

    <button
      id="close-sidebar"
      class="lg:hidden absolute right-2 p-2 text-secondary-500 hover:text-secondary-900 hover:bg-secondary-100 rounded-lg transition-colors focus:outline-hidden"
      aria-label="Close sidebar"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <nav aria-label="Main" class="flex-1 overflow-y-auto px-3 py-3 space-y-0.5">
    <NavLink href={`${lang_prefix}/`} label={t.nav.home ?? "Home"}>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"></path>
      </svg>
    </NavLink>

    <SidebarLinks />

    {nav.map((item) => (
      <NavLink href={`${lang_prefix}${item.href}`} label={t.models[item.table].title ?? item.table}>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M3 9h18M9 21V9"></path>
        </svg>
      </NavLink>
    ))}
  </nav>

  <div class="border-t border-secondary-200 px-3 py-3 space-y-0.5 shrink-0">
    <button
      id="toggle-theme"
      type="button"
      class="w-full flex items-center gap-3 px-3 py-2 text-sm rounded-lg transition-colors text-secondary-700 hover:bg-secondary-100 hover:text-secondary-900"
      aria-label="Toggle dark mode"
    >
      <svg class="shrink-0 block dark:hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
      <svg class="shrink-0 hidden dark:block" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
      </svg>
      <span class="sidebar-label truncate">
        <span class="block dark:hidden">{t.nav.dark_mode ?? "Dark mode"}</span>
        <span class="hidden dark:block">{t.nav.light_mode ?? "Light mode"}</span>
      </span>
    </button>

    {user && user.can_read_users && (
      <NavLink href={`${lang_prefix}/users`} label={t.nav.users ?? "Users"}>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="6" r="4"></circle><path d="M20 17.5c0 2.485 0 4.5-8 4.5s-8-2.015-8-4.5S7.582 13 12 13s8 2.015 8 4.5Z"></path>
        </svg>
      </NavLink>
    )}

    {user && (
      <NavLink href={`${lang_prefix}/settings`} label={t.nav.settings ?? "Settings"}>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 0 0-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 0 0-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 0 0-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 0 0-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 0 0 1.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><circle cx="12" cy="12" r="3"></circle>
        </svg>
      </NavLink>
    )}

    {user && (
      <form action="/logout" method="POST" data-astro-reload>
        <button
          class="w-full flex items-center gap-3 px-3 py-2 text-sm rounded-lg transition-colors text-secondary-700 hover:bg-secondary-100 hover:text-secondary-900"
          type="submit"
        >
          <svg class="shrink-0" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 9l-3 3m0 0l3 3m-3-3h7.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="sidebar-label font-medium truncate">{t.nav.logout ?? "Logout"}</span>
        </button>
      </form>
    )}

    {!user && (
      <NavLink href={`${lang_prefix}/login`} label={t.nav.login ?? "Login"}>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9"></path>
        </svg>
      </NavLink>
    )}
  </div>
</aside>

<script>
  function setActiveLink() {
    const currentPath = window.location.pathname;
    document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]").forEach((link) => {
      const href = link.getAttribute("href");
      if (!href) return;
      const root = href.replace(/\/$/, "") === "";
      const active = root ? currentPath === href : currentPath.startsWith(href);
      if (active) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
    });
  }

  function openSidebar() {
    const sidebar = document.getElementById("nav-menu-1");
    const backdrop = document.getElementById("sidebar-backdrop");
    sidebar?.classList.remove("-translate-x-full");
    backdrop?.classList.remove("hidden");
    setTimeout(() => backdrop?.classList.remove("opacity-0"), 10);
    document.body.style.overflow = "hidden";
  }

  function closeSidebar() {
    const sidebar = document.getElementById("nav-menu-1");
    const backdrop = document.getElementById("sidebar-backdrop");
    sidebar?.classList.add("-translate-x-full");
    backdrop?.classList.add("opacity-0");
    setTimeout(() => backdrop?.classList.add("hidden"), 300);
    document.body.style.overflow = "";
  }

  document.addEventListener("open-sidebar", openSidebar);
  document.addEventListener("astro:before-preparation", closeSidebar);

  function bindOnce(el: HTMLElement | null, key: string, handler: () => void) {
    if (!el || el.dataset.bound === key) return;
    el.dataset.bound = key;
    el.addEventListener("click", handler);
  }

  function setupSidebar() {
    const root = document.documentElement;
    const miniToggle = document.getElementById("toggle-sidebar-mini");

    const syncMiniIcons = (isMini: boolean) => {
      miniToggle?.querySelector(".sidebar-icon-collapse")?.classList.toggle("hidden", isMini);
      miniToggle?.querySelector(".sidebar-icon-expand")?.classList.toggle("hidden", !isMini);
    };
    syncMiniIcons(root.classList.contains("sidebar-mini"));

    bindOnce(miniToggle, "mini", () => {
      const isMini = root.classList.toggle("sidebar-mini");
      localStorage.setItem("sidebar-mini", isMini ? "1" : "0");
      syncMiniIcons(isMini);
    });
    bindOnce(document.getElementById("close-sidebar"), "close", closeSidebar);
    bindOnce(document.getElementById("sidebar-backdrop"), "close", closeSidebar);
    bindOnce(document.getElementById("toggle-theme"), "theme", () => {
      const isDark = root.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });
  }

  document.addEventListener("astro:page-load", () => {
    setActiveLink();
    setupSidebar();
  });
</script>
