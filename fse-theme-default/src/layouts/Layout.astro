---
/**
 * The app shell every theme page renders in: sidebar navigation (see
 * Sidebar.astro), dark mode, view transitions. `sidebar={false}` gives a
 * bare centered page (login, errors, …). A child theme overrides this file
 * to change the shell for every inherited page at once.
 */
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { ssr } from "fse-ssr/ssr";
import type { SsrValue } from "fse-ssr/ssr";
import Head from "../components/Head.astro";
import Logo from "../components/Logo.astro";
import Sidebar from "../components/Sidebar.astro";

interface Props {
  title: string | SsrValue<string>;
  sidebar?: boolean;
}

const { title, sidebar = true } = Astro.props;
const { lang } = ssr();
---

<!doctype html>
<html lang={lang ?? "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <Head />
    <title>{title}</title>
    <!-- Filled by the server with the page's render context as JSON; read it
         client-side via pageProps() from fse-ssr/client. -->
    <script is:inline type="application/json" id="__fse-props__"></script>
    <ClientRouter />
    <script is:inline>
      if (localStorage.getItem("sidebar-mini") === "1") {
        document.documentElement.classList.add("sidebar-mini");
      }
      // Apply the saved (or system) color scheme before first paint.
      (function () {
        const saved = localStorage.getItem("theme");
        const dark =
          saved === "dark" ||
          (!saved && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
      })();
      document.addEventListener("astro:before-swap", (e) => {
        const root = e.newDocument.documentElement;
        if (localStorage.getItem("sidebar-mini") === "1") root.classList.add("sidebar-mini");
        if (document.documentElement.classList.contains("dark")) root.classList.add("dark");
      });
    </script>
  </head>
  <body class="bg-secondary-50 text-secondary-900">
    <div class="relative flex min-h-screen">
      {sidebar && <Sidebar />}
      <div
        class:list={[
          "w-full min-w-0 flex flex-col",
          sidebar && "py-6 px-5 lg:py-8 lg:px-8",
        ]}
      >
        {sidebar && (
          <div class="mb-4 flex items-center gap-4 lg:hidden">
            <button
              id="open-sidebar"
              class="p-1.5 text-secondary-500 hover:text-secondary-900 hover:bg-secondary-100 transition-colors rounded-lg focus:outline-hidden"
              aria-label="Open menu"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line>
              </svg>
            </button>
            <a href="/"><Logo class="h-8 w-auto" /></a>
          </div>
        )}
        <slot />
      </div>
    </div>

    <script>
      document.addEventListener("astro:page-load", () => {
        const openBtn = document.getElementById("open-sidebar");
        if (openBtn && !openBtn.dataset.bound) {
          openBtn.dataset.bound = "1";
          openBtn.addEventListener("click", () =>
            document.dispatchEvent(new CustomEvent("open-sidebar")),
          );
        }
      });
    </script>
  </body>
</html>
